        "required": [
          "id",
          "object",
          "created",
          "model",
          "choices"
        ],
        "additionalProperties": true,
        "x-schema-origin": "Protocol subset and actual proxy response implementation; not an exhaustive upstream protocol guarantee."
      }
    }
  },
  "paths": {
    "/v1/models": {
      "get": {
        "operationId": "listProxyModels",
        "tags": [
          "Models"
        ],
        "summary": "List configured models from all enabled Providers",
        "description": "No pagination. The returned inventory is not filtered by the safe token Provider. Appearance in the list does not establish token authorization, model availability, or model release date; created is the listing time.",
        "externalDocs": {
          "url": "https://docs.desirecore.com/api/model-proxy#proxy-models"
        },
        "security": [
          {
            "ProxyBearer": []
          },
          {
            "ProxyApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Configured model inventory.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Models"
                },
                "example": {
                  "object": "list",
                  "data": [
                    {
                      "id": "your-model-name",
                      "object": "model",
                      "created": 1791943200,
                      "owned_by": "openai"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed; this Messages-shaped error is used for both protocols.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyAuthenticationError"
                },
                "example": {
                  "type": "error",
                  "error": {
                    "type": "authentication_error",
                    "message": "Unauthorized compat-proxy request"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Other backend or reverse-proxy responses. Error formats vary; retain status, Content-Type and body.",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/messages": {
      "post": {
        "operationId": "createProxyMessage",
        "tags": [
          "Protocol requests"
        ],
        "summary": "Request a Messages completion",
        "description": "Requires an exact modelName served by the token-bound Provider. A supplied x-desirecore-provider-id cannot change this binding. stream=true returns protocol-specific SSE; headers or partial text do not establish successful completion. The client executes any authorized tool calls itself.",
        "externalDocs": {
          "url": "https://docs.desirecore.com/api/model-proxy#proxy-messages"
        },
        "security": [
          {
            "ProxyBearer": []
          },
          {
            "ProxyApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "anthropic-version",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "const": "2023-06-01"
            },
            "description": "Stable Messages version; unsupported beta semantics are rejected for external safe-token callers."
          }
        ],
        "x-max-body-bytes": 268435456,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessagesRequest"
              },
              "example": {
                "model": "your-model-name",
                "max_tokens": 64,
                "stream": false,
                "messages": [
                  {
                    "role": "user",
                    "content": "Reply only with OK."
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Non-streaming protocol response or streaming SSE. Read stop/finish reason and errors, including errors after headers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagesResponse"
                },
                "example": {
                  "id": "msg_example",
                  "type": "message",
                  "role": "assistant",
                  "content": [
                    {
                      "type": "text",
                      "text": "OK"
                    }
                  ],
                  "model": "your-model-name",
                  "stop_reason": "end_turn",
                  "stop_sequence": null,
                  "usage": {
                    "input_tokens": 6,
                    "output_tokens": 1
                  }
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Protocol SSE stream, whose structure depends on the protocol and backend."
                }
              }
            }
          },
          "400": {
            "description": "Missing model, invalid route or unsupported protocol input. Upstream errors may use another format.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagesError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed; this Messages-shaped error is used for both protocols.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyAuthenticationError"
                },
                "example": {
                  "type": "error",
                  "error": {
                    "type": "authentication_error",
                    "message": "Unauthorized compat-proxy request"
                  }
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 256 MiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrameworkError"
                }
              }
            }
          },
          "415": {
            "description": "Use Content-Type: application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrameworkError"
                }
              }
            }
          },
          "default": {
            "description": "Other backend or reverse-proxy responses. Error formats vary; retain status, Content-Type and body.",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "createProxyChatCompletion",
        "tags": [
          "Protocol requests"
        ],
        "summary": "Request a Chat Completions completion",
        "description": "Requires an exact modelName served by the token-bound Provider. A supplied x-desirecore-provider-id cannot change this binding. stream=true returns protocol-specific SSE; headers or partial text do not establish successful completion. The client executes any authorized tool calls itself.",
        "externalDocs": {
          "url": "https://docs.desirecore.com/api/model-proxy#proxy-chat-completions"
        },
        "security": [
          {
            "ProxyBearer": []
          },
          {
            "ProxyApiKey": []
          }
        ],
        "parameters": [],
        "x-max-body-bytes": 268435456,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatCompletionRequest"
              },
              "example": {
                "model": "your-model-name",
                "max_completion_tokens": 64,
                "stream": false,
                "messages": [
                  {
                    "role": "user",
                    "content": "Reply only with OK."
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Non-streaming protocol response or streaming SSE. Read stop/finish reason and errors, including errors after headers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionResponse"
                },
                "example": {
                  "id": "chatcmpl_example",
                  "object": "chat.completion",
                  "created": 1791943200,
                  "model": "your-model-name",
                  "choices": [
                    {
                      "index": 0,
                      "message": {
                        "role": "assistant",
                        "content": "OK"
                      },
                      "finish_reason": "stop"
                    }
                  ],
                  "usage": {
                    "prompt_tokens": 6,
                    "completion_tokens": 1,
                    "total_tokens": 7
                  }
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Protocol SSE stream, whose structure depends on the protocol and backend."
                }
              }
            }
          },
          "400": {
            "description": "Missing model, invalid route or unsupported protocol input. Upstream errors may use another format.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatCompletionError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed; this Messages-shaped error is used for both protocols.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyAuthenticationError"
                },
                "example": {
                  "type": "error",
                  "error": {
                    "type": "authentication_error",
                    "message": "Unauthorized compat-proxy request"
                  }
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 256 MiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrameworkError"
                }
              }
            }
          },
          "415": {
            "description": "Use Content-Type: application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrameworkError"
                }
              }
            }
          },
          "default": {
            "description": "Other backend or reverse-proxy responses. Error formats vary; retain status, Content-Type and body.",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
